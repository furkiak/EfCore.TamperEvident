<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EfCore.TamperEvident.AspNetCore</RootNamespace>
    <AssemblyName>EfCore.TamperEvident.AspNetCore</AssemblyName>
    <PackageId>EfCore.TamperEvident.AspNetCore</PackageId>
    <Title>ASP.NET Core integration for EfCore.TamperEvident</Title>
    <Description>ASP.NET Core integration for EfCore.TamperEvident: a Liquid Glass audit dashboard (trail, diffs, record history, verification, exports), scheduled incremental verification, a health check, and HTTP user and request metadata.</Description>
    <PackageTags>efcore;audit;audit-log;dashboard;aspnetcore;health-check;tamper-evident;compliance</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EfCore.TamperEvident\EfCore.TamperEvident.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\*" LogicalName="wwwroot/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EfCore.TamperEvident.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\nuget\EfCore.TamperEvident.AspNetCore\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\docs\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
