<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>EfCore.TamperEvident.Cli</RootNamespace>
    <AssemblyName>tamper-evident</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tamper-evident</ToolCommandName>
    <PackageId>EfCore.TamperEvident.Cli</PackageId>
    <Title>tamper-evident: verify EfCore.TamperEvident evidence bundles</Title>
    <Description>A .NET tool for auditors: verifies EfCore.TamperEvident evidence bundles offline (every hash, link, redaction, signed chain head and anchor), summarizes them, and generates strong secret keys.</Description>
    <PackageTags>audit;audit-trail;tamper-evident;evidence;forensics;compliance;dotnet-tool;efcore</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EfCore.TamperEvident\EfCore.TamperEvident.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\EfCore.TamperEvident.Cli\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\docs\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
