<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Tamper-Evident Audit Trail for EF Core</Title>
    <Authors>Furkan Akca</Authors>
    <PackageTags>efcore;audit;security;tamper-evident;hmac;sqlserver</PackageTags>
    <Description>Transaction-coupled EF Core audit logs with HMAC hash chains, durable external anchor queue and explicit verification limits.</Description>
    <Version>2.0.0-preview.2</Version>
    <RepositoryUrl>https://github.com/furkiak/EfCore.TamperEvident</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\docs\architecture.svg" Pack="true" PackagePath="docs/" />
    <None Include="..\docs\KEY_LIFECYCLE.md" Pack="true" PackagePath="docs/" />
    <None Include="..\docs\LOCAL_VALIDATION.md" Pack="true" PackagePath="docs/" />
    <None Include="..\docs\RUNTIME_SUPPORT.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

</Project>
