<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EfCore.TamperEvident</RootNamespace>
    <AssemblyName>EfCore.TamperEvident</AssemblyName>
    <PackageId>EfCore.TamperEvident</PackageId>
    <Title>Tamper-Evident Audit Trail for EF Core</Title>
    <Description>Tamper-evident, zero-trust audit logging for Entity Framework Core. Every change is sealed into a per-table HMAC-SHA256 hash chain whose head is authenticated and can be anchored outside the database (SMTP, webhook, file), so manipulation by database administrators becomes cryptographically detectable.</Description>
    <PackageTags>efcore;entity-framework-core;audit;audit-log;audit-trail;security;tamper-evident;hash-chain;hmac;compliance;zero-trust</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreMinVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EfCore.TamperEvident.Tests" />
    <InternalsVisibleTo Include="EfCore.TamperEvident.AspNetCore" />
    <InternalsVisibleTo Include="EfCore.TamperEvident.AspNetCore.Tests" />
    <InternalsVisibleTo Include="tamper-evident" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\docs\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
