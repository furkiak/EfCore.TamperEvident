<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EfCore.TamperEvident</RootNamespace>
    <AssemblyName>EfCore.TamperEvident</AssemblyName>
    <PackageId>EfCore.TamperEvident</PackageId>
    <Title>Tamper-Evident Audit Trail for EF Core</Title>
    <Description>Tamper-evident, zero-trust audit logging for Entity Framework Core. Every change is sealed into a per-table HMAC-SHA256 hash chain in the same transaction, with a signed head and anchors outside the database, so manipulation, even by database administrators, is cryptographically detectable. GDPR/KVKK redaction without breaking the chain, reasons and request metadata, incremental and offline verification, history and time travel, OpenTelemetry.</Description>
    <PackageTags>efcore;entity-framework-core;audit;audit-log;audit-trail;security;tamper-evident;hash-chain;hmac;compliance;zero-trust;gdpr;kvkk;redaction;opentelemetry</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreMinVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EfCore.TamperEvident.Tests" />
    <InternalsVisibleTo Include="EfCore.TamperEvident.AspNetCore" />
    <InternalsVisibleTo Include="EfCore.TamperEvident.AspNetCore.Tests" />
    <InternalsVisibleTo Include="tamper-evident" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\nuget\EfCore.TamperEvident\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\docs\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
