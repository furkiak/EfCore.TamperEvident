<Project>
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <EfCoreVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.20</EfCoreVersion>
    <EfCoreVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.12</EfCoreVersion>
  </PropertyGroup>
</Project>
